###############################################################################
#                          🔑 API Configuration                                  #
###############################################################################

## Adamik API
# These variables are prefixed with VITE_ to make them accessible in the client-side code
# For local development, use:
VITE_ADAMIK_API_BASE_URL="http://localhost:3000"
# For production, use:
# VITE_ADAMIK_API_BASE_URL="https://api.adamik.io"

# Your Adamik API key (get one at https://adamik.io/dashboard)
VITE_ADAMIK_API_KEY="<your-api-key-here>"

###############################################################################
#                          🔐 Signer Configuration                              #
###############################################################################

## Sodot (Optional)
# Vertex endpoints and API keys for the Sodot MPC network
# All Sodot variables must be prefixed with VITE_ to be accessible in the browser
VITE_SODOT_VERTEX_URL_0="https://vertex-demo-0.sodot.dev"
VITE_SODOT_VERTEX_API_KEY_0="<Sodot Vertex API Key 0>"

VITE_SODOT_VERTEX_URL_1="https://vertex-demo-1.sodot.dev"
VITE_SODOT_VERTEX_API_KEY_1="<Sodot Vertex API Key 1>"

VITE_SODOT_VERTEX_URL_2="https://vertex-demo-2.sodot.dev"
VITE_SODOT_VERTEX_API_KEY_2="<Sodot Vertex API Key 2>"

# Comma-separated list of existing key IDs
VITE_SODOT_EXISTING_ECDSA_KEY_IDS="<key1-id>,<key2-id>,<key3-id>"
VITE_SODOT_EXISTING_ED25519_KEY_IDS="<key1-id>,<key2-id>,<key3-id>"

## Turnkey (Optional)
# These variables are prefixed with VITE_ to make them accessible in the client-side code
VITE_TURNKEY_API_PUBLIC_KEY="<your-turnkey-api-public-key>"
VITE_TURNKEY_API_PRIVATE_KEY="<your-turnkey-api-private-key>"
VITE_TURNKEY_BASE_URL="https://api.turnkey.com"
VITE_TURNKEY_ORGANIZATION_ID="<your-turnkey-organization-id>"
VITE_TURNKEY_WALLET_ID="<your-turnkey-wallet-id>"

###############################################################################
#                            ⚠️ WARNING ⚠️                                      #
#                                                                             #
# This is a local environment file template. To use it:                       #
# 1. Copy this file and rename it to .env.local                              #
# 2. Replace all placeholder values (text between < >)                        #
# 3. Never commit your actual .env.local file to version control             #
# 4. Keep your API keys and credentials secure                               #
###############################################################################

## ⚠️ Development Only - Local Signer
# WARNING: This is for development and testing only!
# DO NOT use this seed phrase with real funds or in production!
# Must be prefixed with VITE_ to be accessible in the browser
VITE_UNSECURE_LOCAL_SEED="<your-12-word-mnemonic-phrase>"

## 🔒 Security Best Practices:
# 1. Use proper key management solutions in production (SODOT or Turnkey)
# 2. Never share or commit your seed phrases or private keys
# 3. Keep your .env.local file in .gitignore
# 4. Regularly rotate your API keys and credentials
# 5. Use different keys for development and production
# 6. Monitor your API usage and set up alerts for suspicious activity